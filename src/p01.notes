# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x65F7 sale_de_la_casilla pasa a la casilla vecina por el lado de salida
L 0x663A carga_la_zona carga la zona de 0xC280
L 0x67B3 borra_las_figuras borra todas las figuras
L 0x67CC borra_al_jugador borra al jugador
L 0x67DA esconde_los_sprites_de_ram saca de la pantalla los sprites de la copia en RAM
L 0x6C03 teclea_la_contrasena la pantalla de la contrasena
L 0x6C7A aplica_la_contrasena saca de la contrasena la fase, el jugador, la zona y la casilla
L 0x6CAB junta_nibbles junta dos nibbles en un byte
L 0x6CD8 lee_el_teclado lee una tecla
L 0x7804 caracter_bajo el caracter que hay bajo un punto
L 0x781F se_puede_pisar carry si el caracter se puede pisar
L 0x7EAB busca_al_vecino busca el Game Master o Q*bert en otra ranura (0xEF00)
