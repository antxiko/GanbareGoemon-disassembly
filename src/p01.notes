# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6034 estado_8 la zona pasada: su pantalla, el tiempo a puntos y la zona siguiente
L 0x609C estado_9 se sale de la casilla
L 0x60D4 estado_0a la pausa: F1 la quita, F2 al estado 0x0D, y se teclean las palabras
L 0x610A estado_0b la fase pasada
L 0x61AF estado_0c el menu del vecino (Game Master o Q*bert en la otra ranura)
L 0x6232 estado_0d F2 en la pausa
L 0x6256 estado_0e la contrasena
L 0x6292 estado_0f el final del juego
L 0x62FE tras_el_titulo en los estados 0-2: una tecla salta al titulo, o en el menu elige
L 0x635A ventana_de_la_pausa la ventana con el texto de la pausa
L 0x6374 quita_la_ventana devuelve lo que tapaba la ventana de la pausa
L 0x6382 ventana guarda en la pagina 1 el rectangulo de (H, L), B x C, lo borra y le pone marco
L 0x643F logotipo_de_konami prepara el logotipo de Konami en la pagina 1
L 0x6486 destapa_el_logotipo una linea mas del logotipo cada dos cuadros; al acabar, 0xC482 = 1
L 0x64A9 cartel caracteres de HL en DE de la pagina 1; 0xFE [dx] baja, 0xFF acaba
L 0x650A tiempo_a_puntos el tiempo que queda, a puntos: 10 por segundo
L 0x653C texto_del_final monta en 0xD800 el texto del final, uno de cuatro
L 0x65A2 sprites_del_final los 16 sprites de la ultima pantalla
L 0x65F7 sale_de_la_casilla 0xC281 = la casilla vecina por el lado de 0xC283 (enlaces de 0xE780)
L 0x6617 enlaces_de_la_casilla los cuatro enlaces de la casilla a 0xC284-0xC287
L 0x662C prepara_la_partida letras, dibujos de siempre y la vida a 0x10
L 0x663A carga_la_zona carga la zona de 0xC280: graficos, pantallas, bloques, casillas, vida y tiempo, y entra en la casilla
L 0x66F6 entra_en_la_casilla monta y pinta la casilla con sus figuras
L 0x672F entra_por_el_lado_5 la casilla sin cosas fijas, con el jugador abajo en medio
L 0x6756 punto_de_entrada la primera vez en la zona, el jugador en el primer sitio de 0xB8E0 donde se puede pisar
L 0x6798 jugador_abajo_en_medio el jugador en (0x80, 0xB0); por el lado 6, solo la musica
L 0x67B3 borra_las_figuras el tipo a 0 en las ocho fichas de 0xC600 y las ocho de 0xCA00
L 0x67CC borra_al_jugador los 0x60 bytes del jugador (0xC490) a cero
L 0x67DA esconde_los_sprites_de_ram y = 0xE0 en los 32 sprites de la copia de 0xEE00
L 0x67E8 las_dos_de_0xc4d3 p01:76AC con 0xC4D3 y con 0xC4E3
L 0x67F4 borra_las_de_0xcc00 0xCC00-0xCCFF a cero
L 0x6802 cuadro_del_juego un cuadro del juego: el jugador en los pares, las figuras en los impares
L 0x6877 f1_pausa F1 recien apretada: la pausa (0xC008 = 1) y carry
L 0x688B empieza_la_demo la demostracion: el otro jugador, zona 0, casilla 12, 99 vidas y 999 ryo
L 0x68F3 cuadro_de_la_demo un cuadro de la demostracion
L 0x6923 teclas_de_la_demo la tecla de la demostracion, cada dos cuadros
L 0x693F tecla_de_la_demo la tecla siguiente del guion de 0x6955
L 0x69D1 pasadizo se entra o se sale de un pasadizo
L 0x6A06 tramo_siguiente al tramo siguiente o al anterior del pasadizo
L 0x6A14 pinta_el_tramo la pantalla del tramo de pasadizo 0xC484
L 0x6A59 destino_del_pasadizo el tramo al entrar (0xEA80) o la casilla al salir (0xEB00)
L 0x6A9C en_la_puerta pone al jugador junto a la puerta (figura 6 o 7)
L 0x6AFC pasadizos_de_la_zona los tramos y las puertas de los pasadizos de la zona, a 0xEA00, 0xEA80 y 0xEB00
L 0x6B5F ensena_la_contrasena F2 en la pausa: la contrasena del sitio donde se esta
L 0x6BE7 quita_la_contrasena devuelve lo que tapaba la ventana de la contrasena
L 0x6BF5 en_dos_nibbles A en (HL) y (HL+1): el nibble de arriba y el de abajo
L 0x6C03 teclea_la_contrasena una letra mas de la contrasena; con 9, la deshace y mira la suma: carry al acabar, 0xEB82 = 1 si vale
L 0x6C7A aplica_la_contrasena la fase, el jugador, la zona, la casilla y los colores de la contrasena de 0xEBC0
L 0x6CAB junta_nibbles A = L * 16 + H
L 0x6CB8 contrasena_en_blanco nada tecleado
L 0x6CD8 lee_el_teclado lee una tecla
L 0x6D38 el_jugador el jugador, un cuadro: mandos y su estado (tabla de 0x6D4C)
L 0x6D58 jugador_en_el_suelo estado 0: andar, saltar, el golpe, los hoyos
L 0x6D9F anda segun la direccion de A: velocidad y lado
L 0x6DB9 pide_el_golpe 0xC492 = 1
L 0x6DBF salta el salto: estado 1 y el efecto 1
L 0x6DD6 cae_al_hoyo estado 2 y la musica 0x0B
L 0x6E7B velocidad_del_jugador 0xC4A3 segun las cosas 0 (0x6E92) y parado
L 0x6E9A jugador_saltando estado 1: la curva del salto
L 0x6F48 jugador_cayendo estado 2: baja y, al acabar la musica, pierde
L 0x6F60 sprites_en_la_y los 16 sprites de la copia en la y del jugador + C
L 0x6F8F jugador_despedido estado 3: sin vida o sin tiempo, sale despedido
L 0x700A pierde fuera las cosas 0 y 1, a la entrada de la zona y el dinero a la mitad
L 0x701E dinero_a_la_mitad el dinero (BCD) entre dos
L 0x706E jugador_al_pasadizo estado 4: baja dando vueltas y entra o sale del pasadizo
L 0x70A9 jugador_sale_de_la_zona estado 5: la puerta y sube; al acabar, 0xC282 = 1
L 0x70F5 pinta_la_puerta la puerta de salida de la zona, 32 x 32
L 0x710E baja_0xc4a7 0xC4A7 cuenta hasta 0
L 0x7116 prisas por debajo de 50 segundos, su musica
L 0x715D sin_vida_o_tiempo sin vida (y sin la cosa 7) o sin tiempo: estado 3
L 0x71A2 direccion_que_vale 0xC485 = la direccion apretada
L 0x71BB bordes por los lados se sale de la casilla; puertas e interiores
L 0x7258 puertas con arriba ante una puerta, se entra en el interior
L 0x729D salida_del_interior con abajo en la salida, fuera del interior
L 0x72E6 salidas_especiales las puertas de 0xC28A: la de la zona (3 cosas 9) y la de la fase
L 0x7370 mueve_al_jugador posicion += velocidad
L 0x7395 donde_para_el_salto 0xC4A6: los pasos del salto en los que hay pared
L 0x741B hasta_donde_salta segun las cosas 0, A = 0 sigue o compara con los cuadros del salto
L 0x74A6 sprites_del_jugador_de_ram la posicion y los patrones de sus sprites en la copia de 0xEE00
L 0x75E4 el_golpe el golpe del primer boton, o lanza algo con la cosa 1
L 0x762B lanza en un hueco libre de 0xC4D0 o 0xC4E0, con el efecto 9
L 0x7655 velocidad_de_lo_lanzado 4 puntos por cuadro hacia donde mira
L 0x766C hay_algo_lanzado NZ si 0xC4D0 o 0xC4E0 estan en uso
L 0x7675 mueve_lo_lanzado posicion += velocidad de los dos
L 0x768E lanzado_fuera borra los que se salen de la pantalla
L 0x76AC borra_lo_lanzado sus 16 bytes a cero y su sprite fuera
L 0x76D1 lo_lanzado un cuadro de lo lanzado
L 0x771F choca_arriba carry si hay pared encima
L 0x7741 choca_abajo carry si hay pared debajo
L 0x7763 en_un_hoyo carry si bajo los dos pies hay hoyo
L 0x777E choca_derecha carry si hay pared a la derecha
L 0x7794 choca_izquierda carry si hay pared a la izquierda
L 0x77AA topes_del_juego pared y hoyos del juego de graficos, a 0xC4F0
L 0x77D1 es_pared carry si el caracter A es pared
L 0x77FD es_hoyo carry si el caracter A es hoyo
L 0x7804 caracter_bajo A = el caracter de 0xD800 en el punto (D, E)
L 0x781F no_se_puede_estar carry si en (D, E) no se puede estar: hoyo o pared (0xC4F1, 0xC4F0)
L 0x7833 choques los choques del jugador con las figuras, sus disparos, su golpe y lo lanzado
L 0x7855 figuras_contra_el_jugador si le toca una figura que hace dano: parpadeo, efecto y lo que pierde
L 0x78C4 disparos_contra_el_jugador si le toca un disparo de 0xCA00: 2 de vida o lo que lo pare
L 0x78FA golpe_contra_las_figuras si el golpe da a una figura: puntos y dinero
L 0x7926 efecto_del_golpe el efecto 0x0D (0x0C con el tipo 3)
L 0x793C lanzado_contra_las_figuras si lo lanzado da a una figura: puntos y dinero, y se borra
L 0x7980 puntos_del_tipo suma los puntos del tipo de la figura (0xB84C, en centenas)
L 0x799D dinero_del_tipo suma el dinero del tipo (0xB86D); los tipos 8 y 0x21 quitan 50
L 0x79C8 toca_la_buena tocar un tipo 8 o 0x21: 1000 puntos (y 10 ryo con el bit 1 de 0xEF80)
L 0x79E2 quita_la_cosa_0a pierde la cosa 0x0A; sin ella, 20 ryo
L 0x79F0 quita_20_ryo 20 ryo menos
L 0x79F6 quita_4_de_vida 4 de vida menos
L 0x79F8 quita_vida B de vida menos, hasta 0
L 0x7A04 quita_2_de_vida 2 de vida menos
L 0x7A08 lo_para carry si lleva lo que para a ese tipo, y se gasta uno
L 0x7A20 gasta_una si (HL) no es cero, una menos y carry
L 0x7A29 repinta_la_cosa pinta la cosa de la direccion L (0xC270 + n)
L 0x7A2F lo_para_del_disparo como lo_para, para los disparos
L 0x7A3E toca_el_disparo carry si el disparo IX toca al jugador
L 0x7A4E toca_la_figura carry si la figura IX toca al jugador
L 0x7A61 le_da_el_golpe carry si el golpe da a la figura IX
L 0x7A73 le_da_lo_lanzado carry si lo lanzado da a la figura IX
L 0x7A85 caja_del_tipo A = la clase de caja del tipo, B y C su centro
L 0x7ACA caja_del_disparo A = la clase de caja del disparo, B y C su centro
L 0x7B49 toca_al_jugador carry si la caja (H, L) en (B, C) toca al jugador
L 0x7B67 toca_al_golpe carry si la caja toca el golpe, delante del jugador
L 0x7BAA toca_lo_lanzado carry si la caja toca alguno de los dos lanzados
L 0x7BBC toca_al_lanzado carry si la caja toca el lanzado IY
L 0x7BDA lo_del_suelo las cosas de 0xCC00: se cogen, o una boca de pasadizo
L 0x7CDB golpe_al_0e el golpe contra el tipo 0x0E de 0xCC00
L 0x7D0D entrada_del_laberinto con 0xCDB0, arriba en (0x30-0x50, 0x40) se entra en el laberinto
L 0x7D30 cerca_de_la_figura carry si el jugador esta a menos de 32 de la figura
L 0x7D4A toca_de_8 carry si el jugador toca la caja de 8 x 8 de la figura
L 0x7D56 coge lo que da el tipo 1 (la cosa 1) o el 2 (la cosa 0), o 10 ryo
L 0x7D7E efecto_del_tipo el efecto de sonido del tipo (0x7D98)
L 0x7D9E salidas_de_la_casilla 0xC520: la salida especial de la casilla (tabla 0xB5D6)
L 0x7DE9 cosas_de_la_casilla la lista de 0xC500 de la casilla (tabla 0x981D)
L 0x7E34 vacia_0xc500 0xC500-0xC52F a cero
L 0x7E42 las_del_tipo_14 las cosas de tipo 0x14 de la zona a 0xC340; una al azar marcada
L 0x7E9D limpia_0xc340 deja solo el bit 7 de cada marca de 0xC340
L 0x7EAB busca_al_vecino 0xEF00 = 0xFF si hay un Game Master (firma en 0x7FFA) o un Q*bert (0xBFFA) en otra ranura
L 0x7ED1 busca_en_subranuras las cuatro subranuras de la ranura C
L 0x7EE5 es_el_vecino carry si en la ranura C esta la firma de Q*bert o la del Game Master
L 0x7EF9 compara_en_ranura carry si los B bytes de HL en la ranura C son los de DE
L 0x7F1A menu_del_vecino la ventana, el marco y el texto del menu
L 0x7F28 ventana_del_menu borra (0x20, 0x90), 0xC0 x 0x38
L 0x7F2E rellena_y_mide rellena (H, L) B x C del color 0; DE = el tamano
L 0x7F39 ventana_con_marco rellena y le pone marco
L 0x7F83 opcion_1 texto y numero (0xEF05) de la opcion 1
L 0x7FA3 opcion_2 texto y numero (0xEF07) de la opcion 2
L 0x7FB1 texto_de_opcion borra la linea y pinta el rotulo de HL
L 0x7FC8 borra_las_opciones borra (0x24, 0xA0), 0xB8 x 0x20
L 0x7FD1 cifra_del_menu la cifra tecleada en el menu del vecino
