# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8334 crea_figura crea una figura en el primer hueco libre de 0xC600
L 0x87B7 borra_la_figura borra la figura
L 0x87E4 pon_velocidad_x velocidad horizontal de la figura ((ix+8), (ix+9)) = DE
L 0x87EB pon_velocidad_y velocidad vertical de la figura ((ix+6), (ix+7)) = DE
L 0x893D pon_la_pose pone la pose de la figura
L 0x89C2 dispara crea el disparo A (tabla de 0x8B6B)
L 0x8C0A niega_de DE = -DE
L 0x90C0 cosas_fijas pinta las cosas fijas de la casilla
L 0x960C texto_de_la_zona el texto de la zona
L 0x99FB dibujo_de_caracteres pinta un dibujo hecho de caracteres
C 0x8056 lee las banderas de la partida (bit 7 jugador 2, bit 6 en juego)
C 0x8065 apunta a las vidas
C 0x806E intercambia: intercambia los bytes de (HL) y (DE)
C 0x807E guarda la ZONA (0-6)
C 0x8092 guarda las vidas
C 0x80C6 hl_mas_a: HL += A
C 0x80CD letra: pinta la letra A en DE (D = x, E = y), copiandola de la pagina 1; 0 es un hueco
C 0x80D3 letra: pinta la letra A en DE (D = x, E = y), copiandola de la pagina 1; 0 es un hueco
C 0x80EA sube_colores_de_sprite: la copia de 0xEC00-0xEE7F (colores y atributos de los sprites) a 0xF400
C 0x810F hmmm: orden HMMM del V9938: copia el rectangulo de (H, L) a (D, E), B x C; paginas en A
C 0x8125 rotulo_numero: pinta el rotulo A de la tabla de 0xA9C0 (banco 12)
C 0x8130 marco: pinta un marco: (H, L), D de ancho, E de alto, color C
C 0x813B marco: pinta un marco: (H, L), D de ancho, E de alto, color C
