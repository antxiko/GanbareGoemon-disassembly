# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 sonido_del_cuadro un cuadro de sonido: musica y efectos
L 0x605F al_manejador 0xC09C el canal del PSG, 0xC09D la ficha; salta a HL
L 0x6067 canal_en_reposo el canal que no suena
L 0x608F pon_el_tono escribe el tono del canal en el PSG
L 0x609B pon_el_volumen escribe el volumen del canal en el PSG
L 0x60A3 mezclador_nada el canal, ni tono ni ruido
L 0x60AA mezclador_ruido el canal, con ruido
L 0x60B1 mezclador_tono_y_ruido el canal, con tono y ruido
L 0x60B8 mezclador_tono el canal, con tono
L 0x60ED musica_de_la_pausa la ficha 0xC082
L 0x60F4 canal_a la ficha 0xC01A
L 0x60FB canal_b la ficha 0xC034
L 0x6102 canal_c la ficha 0xC04E
L 0x6106 un_canal un cuadro del canal de la ficha IX
L 0x6165 vibrato el vibrato del canal
L 0x61F1 lee_la_partitura lee la nota siguiente de la partitura
L 0x631B silencio una pausa de la partitura
L 0x6341 orden_de_la_partitura las ordenes 0xD0-0xFF
L 0x6449 el_efecto un cuadro del efecto (ficha 0xC068)
L 0x6454 cuadro_del_efecto un cuadro del efecto de sonido
C 0x6029 guarda el manejador del canal A del sonido y el byte siguiente (16 bits)
C 0x602C guarda el manejador del canal B del sonido y el byte siguiente (16 bits)
C 0x602F guarda el manejador del canal C del sonido y el byte siguiente (16 bits)
C 0x6033 guarda los canales que suenan
C 0x6040 lee el manejador del canal A del sonido y el byte siguiente (16 bits)
C 0x6043 al_manejador: 0xC09C el canal del PSG, 0xC09D la ficha; salta a HL
